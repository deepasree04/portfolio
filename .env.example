# EmailJS Configuration Keys
# Replace these with your actual EmailJS credentials to enable live contact form deliveries.
# If these variables are not provided, the contact form will fall back to a clean simulation mode.
VITE_EMAILJS_SERVICE_ID=YOUR_SERVICE_ID
VITE_EMAILJS_TEMPLATE_ID=YOUR_TEMPLATE_ID
VITE_EMAILJS_PUBLIC_KEY=YOUR_PUBLIC_KEY
